# OpenAI-compatible server. For direct OpenAI use https://api.openai.com/v1 and an API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copilot-mtcporto.vercel.app/v1
OPENAI_MODEL=gpt-4o

# ACLED OAuth (server only)
ACLED_ACCESS_TOKEN=
ACLED_USERNAME=
ACLED_PASSWORD=

# Turso/libSQL (server only)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ReliefWeb requires a pre-approved app name (https://apidoc.reliefweb.int/)
RELIEFWEB_APPNAME=globalconflictcompass
